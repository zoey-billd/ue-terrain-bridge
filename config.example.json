{
  "comment": "复制本文件为 config.json,把下面所有 C:/Path/To/... 改成你的实际路径(用正斜杠 /)。",
  "paths": {
    "project_root": "C:/Path/To/YourUEProject",
    "bridge_root": "C:/Path/To/YourUEProject/TerrainBridge",
    "gaea_out": "C:/Path/To/YourUEProject/TerrainBridge/gaea_out",
    "gaea_extra_roots": [
      "C:/Users/YOUR_USER/Documents/Gaea/Builds"
    ],
    "houdini_out": "C:/Path/To/YourUEProject/TerrainBridge/houdini_out",
    "backups": "C:/Path/To/YourUEProject/TerrainBridge/backups",
    "logs": "C:/Path/To/YourUEProject/TerrainBridge/logs"
  },
  "gaea": {
    "enabled": true,
    "gaea_exe": "C:/Path/To/Gaea/Gaea.exe",
    "heightmap_filename": "height.exr",
    "mode": "watch",
    "_comment_mode": "watch=等待手动导出的高度图; cli=尝试用 Gaea 命令行导出(若 BuildManager 可用)"
  },
  "houdini": {
    "enabled": true,
    "hython": "C:/Path/To/Houdini/Houdini 21.0.631/bin/hython.exe",
    "script": "C:/Path/To/YourUEProject/TerrainBridge/houdini_process.py",
    "input_heightmap": "C:/Path/To/YourUEProject/TerrainBridge/gaea_out/height.exr",
    "output_height": "C:/Path/To/YourUEProject/TerrainBridge/houdini_out/height_16bit.png",
    "output_weights": {
      "grass": "C:/Path/To/YourUEProject/TerrainBridge/houdini_out/weight_grass.png",
      "rock": "C:/Path/To/YourUEProject/TerrainBridge/houdini_out/weight_rock.png",
      "dirt": "C:/Path/To/YourUEProject/TerrainBridge/houdini_out/weight_dirt.png"
    },
    "weight_rules": {
      "_comment": "权重图生成规则, 基于坡度/海拔/曲率",
      "grass_max_slope_deg": 30,
      "grass_max_elev": 2000,
      "rock_min_slope_deg": 35,
      "dirt_slope_range": [20, 45]
    }
  },
  "unreal": {
    "bridge_port": 9877,
    "level_path": "/Game/YourLevel",
    "landscape_label": "Landscape",
    "landscape_location": [-50400, -50400, 0],
    "layer_mapping": {
      "Layer_1": "grass",
      "Layer_2": "rock",
      "Layer_3": "dirt"
    },
    "height_scale_z": 100,
    "xy_scale": 100,
    "regen_pcg_labels": [],
    "save_after": true
  }
}
