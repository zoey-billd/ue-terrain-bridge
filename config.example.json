{
  "comment": "复制本文件为 config.json,把下面所有 C:/Path/To/... 改成你的实际路径(用正斜杠 /)。",
  "paths": {
    "project_root": "C:/Path/To/YourUEProject",
    "bridge_root": "C:/Path/To/YourUEProject/TerrainBridge",
    "gaea_out": "C:/Path/To/YourUEProject/TerrainBridge/gaea_out",
    "gaea_extra_roots": [
      "C:/Users/YOUR_USER/Documents/Gaea/Builds"
    ],
    "converted": "C:/Path/To/YourUEProject/TerrainBridge/converted",
    "backups": "C:/Path/To/YourUEProject/TerrainBridge/backups",
    "logs": "C:/Path/To/YourUEProject/TerrainBridge/logs"
  },
  "gaea": {
    "enabled": true,
    "gaea_exe": "C:/Path/To/Gaea/Gaea.exe",
    "heightmap_filename": "height.exr",
    "mode": "watch"
  },
  "outputs": {
    "_comment": "height_png 是插件自动转换出的 16-bit PNG;weights 是 Gaea 直接导出的权重图(在 Gaea 里输出 PNG)",
    "height_png": "C:/Path/To/YourUEProject/TerrainBridge/converted/height_16bit.png",
    "weights": {
      "grass": "C:/Path/To/YourUEProject/TerrainBridge/gaea_out/W_grass.png",
      "rock": "C:/Path/To/YourUEProject/TerrainBridge/gaea_out/W_rock.png",
      "dirt": "C:/Path/To/YourUEProject/TerrainBridge/gaea_out/W_dirt.png"
    }
  },
  "unreal": {
    "bridge_port": 9877,
    "level_path": "/Game/YourLevel",
    "landscape_label": "Landscape",
    "landscape_location": [-50400, -50400, 0],
    "layer_mapping": {
      "Layer_1": "grass",
      "Layer_2": "rock",
      "Layer_3": "dirt"
    },
    "height_scale_z": 100,
    "xy_scale": 100,
    "regen_pcg_labels": [],
    "save_after": true
  }
}
